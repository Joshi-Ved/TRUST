# ==============================================================================
# TRUST Protocol - Environment Variables & Configurations
# ==============================================================================

# Database (PostgreSQL via Supabase, Neon, or Local)
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/trust_db?schema=public"

# Redis (BullMQ queue & distributed lock engine)
REDIS_URL="redis://127.0.0.1:6379"

# Generative AI Pipeline
# Script generator: Gemini is used when set (GEMINI_MODEL optional, default gemini-flash-latest); OpenAI only as a fallback
GEMINI_API_KEY="your-gemini-api-key"
OPENAI_API_KEY="sk-proj-your-openai-api-key"

# EVM & Web3 RPC Endpoints
NEXT_PUBLIC_SEPOLIA_RPC="https://ethereum-sepolia-rpc.publicnode.com"
TRUST_ESCROW_CONTRACT_ADDRESS="0x89205A3A3b2A69De6Dbf7f01ED13B2108B2c43e7"
USDC_SEPOLIA_ADDRESS="0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238"

# Internet Computer (ICP) Canister Configuration
NEXT_PUBLIC_TRUST_CANISTER_ID="rrkah-fqaaa-aaaaa-aaaaq-cai"
NEXT_PUBLIC_IC_HOST="https://icp0.io"

# Crawler Automation
AUTO_SEED="false"
